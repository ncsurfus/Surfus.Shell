<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Surfus.Shell\Surfus.Shell.csproj" />
    <ProjectReference Include="..\Surfus.Shell.Cisco\Surfus.Shell.Cisco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Build the Go test SSH server before running tests -->
  <Target Name="BuildGoTestServer" BeforeTargets="Build">
    <Exec Command="mise exec -- go build -o testserver ." WorkingDirectory="$(MSBuildProjectDirectory)/testserver" />
  </Target>

</Project>
